# Environment Variables — Copy this to .env and fill in your values
# NEVER commit .env to GitHub

# === DATABASE ===
# For local development (PostgreSQL running on your machine):
# DATABASE_URL=postgresql://postgres:yourpassword@localhost:5432/sports_intelligence

# For Neon (cloud PostgreSQL — recommended):
# DATABASE_URL=postgresql://user:password@ep-xxx.us-east-2.aws.neon.tech/sports_intelligence?sslmode=require

# For Supabase:
# DATABASE_URL=postgresql://postgres:password@db.xxxx.supabase.co:5432/postgres

# NOTE: Never commit a real password. Use the placeholder below.
# Your real value goes ONLY in the gitignored .env file.
# If you ever committed a real value here, rotate the DB password.
DATABASE_URL=postgresql://user:your_password_here@ep-xxx.us-east-2.aws.neon.tech/neondb?sslmode=require

# === FOOTBALL DATA API ===
# Get your free key at: https://www.football-data.org/client/register
# Free tier: 12 competitions, 10 req/min, delayed scores (NOT real-time)
FOOTBALL_DATA_API_KEY=your_key_here
# football-data.org v4 competition id (2021 = English Premier League)
FOOTBALL_DATA_COMPETITION_ID=2021

# === APP SETTINGS ===
APP_ENV=development
SECRET_KEY=change-this-in-production-use-openssl-rand-hex-32
DEBUG=True

# === CACHE SETTINGS (seconds) ===
FIXTURES_CACHE_TTL=1800
LEAGUE_TABLE_CACHE_TTL=3600
