FOOTBALL_DATA_API_KEY=

# ── App Config ───────────────────────────────────────────────
FOOTBALL_DATA_COMPETITION_ID=PL
FIXTURES_CACHE_TTL=300
LEAGUE_TABLE_CACHE_TTL=600
